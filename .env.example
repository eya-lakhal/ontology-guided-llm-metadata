# LLM provider: "ollama" (default, local), "openai" (any OpenAI-compatible API) or "mock" (offline, deterministic)
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
# Only needed for LLM_PROVIDER=openai
LLM_API_KEY=
# Ollama default: http://localhost:11434 ; OpenAI-compatible example: https://api.openai.com/v1
LLM_BASE_URL=http://localhost:11434
